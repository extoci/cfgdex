{
  "name": "cfgdex",
  "version": "0.1.10",
  "description": "A calm settings manager for Codex config.toml",
  "keywords": [
    "cli",
    "codex",
    "config",
    "developer-tools",
    "openai",
    "toml"
  ],
  "homepage": "https://github.com/extoci/cfgdex#readme",
  "bugs": {
    "url": "https://github.com/extoci/cfgdex/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extoci/cfgdex.git"
  },
  "bin": {
    "cfgdex": "bin/cfgdex.mjs"
  },
  "files": [
    "app",
    "bin",
    "public",
    "server",
    "src",
    "scripts",
    "index.html",
    "tsconfig.json",
    "vite.config.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:named": "bun bin/dev-named.mjs",
    "build": "vite build",
    "start": "vite preview",
    "test": "bun run build && bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "schema:sync": "bun scripts/sync-config-schema.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "portless": "0.12.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "smol-toml": "1.7.1",
    "vite": "8.0.13"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
